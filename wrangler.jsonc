{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "6789tv1",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-04",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
